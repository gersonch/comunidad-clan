---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Enviar correos - Admin">
  <div class="bg-gradient-to-br from-slate-500 to-[#111] bg-fixed bg-cover bg-no-repeat min-h-screen flex flex-col items-center">
    <h1 class="text-white text-3xl text-center pt-10 mb-8">Enviar correos</h1>
    <form class="bg-slate-800 p-8 rounded-2xl max-w-lg w-full shadow-2xl border border-slate-700 flex flex-col gap-6">
      <input type="email" name="to" placeholder="Para (correo)" class="px-4 py-3 rounded-lg bg-slate-700 text-white border border-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500 transition" required />
      <input type="text" name="subject" placeholder="Asunto" class="px-4 py-3 rounded-lg bg-slate-700 text-white border border-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500 transition" required />
      <textarea name="body" placeholder="Mensaje" rows="6" class="px-4 py-3 rounded-lg bg-slate-700 text-white border border-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500 transition" required></textarea>
      <button type="submit" class="bg-gradient-to-r from-blue-600 to-blue-800 hover:from-blue-700 hover:to-blue-900 text-white font-bold py-3 px-4 rounded-lg shadow-lg transition-all duration-200">Enviar</button>
    </form>
  </div>
</Layout>
