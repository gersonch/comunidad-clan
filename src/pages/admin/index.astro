---
import Layout from '../../layouts/Layout.astro';
---

    <Layout title="Admin - Comunidad Clan">
        <div class="bg-gradient-to-br from-slate-500 to-[#111] bg-fixed bg-cover bg-no-repeat min-h-screen">
        <h1 class="text-white text-4xl text-center pt-10 mb-8">Administración</h1>
        <nav class="flex flex-col md:flex-row justify-center gap-6 mb-12">
            <a href="/admin/correos" class="bg-slate-700 hover:bg-slate-800 text-white px-8 py-4 rounded-xl text-xl font-semibold shadow transition">Enviar correos</a>
            <a href="/admin/eventos" class="bg-slate-700 hover:bg-slate-800 text-white px-8 py-4 rounded-xl text-xl font-semibold shadow transition">Eventos</a>
            
        </nav>
        <section class="mt-8 bg-slate-900/80 p-8 rounded-2xl max-w-md mx-auto shadow-2xl border border-slate-700">
                <h2 class="text-white text-3xl mb-6 text-center font-bold tracking-wide">Acceso Administrador</h2>
                <div class="flex flex-col gap-5">
                    <input type="text" name="username" placeholder="Usuario" class="px-4 py-3 rounded-lg bg-slate-800 text-white border border-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500 transition" required />
                    <input type="password" name="password" placeholder="Contraseña" class="px-4 py-3 rounded-lg bg-slate-800 text-white border border-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500 transition" required />
                    <button type="submit" class="bg-gradient-to-r from-blue-600 to-blue-800 hover:from-blue-700 hover:to-blue-900 text-white font-bold py-3 px-4 rounded-lg shadow-lg transition-all duration-200">Iniciar sesión</button>
                </div>
            </section>
    </div>
</Layout>