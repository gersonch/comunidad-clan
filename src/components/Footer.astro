---
import LogoBlanco from "./LogoBlanco.astro";
import NewsletterForm from "./react-components/NewsletterForm.jsx";
---

<div class="bg-black text-white p-4">
    <section >
        <div class="max-w-xl md:max-w-5xl mx-auto my-0  flex flex-col gap-4">
            <div >
                
                    <div class="my-4">
                        <a href="../" class="inline-block">
                            <LogoBlanco />
                        </a>
                    </div>
                
                <main class="flex flex-col justify-between gap-4 md:flex-row ">
                    <div class="flex flex-col gap-4">
                        <h2 class="font-bold">Nos puedes encontrar en:</h2>
                        <a href="https://www.google.com/maps/dir/-36.6332685,-72.0586561/sydney+college/@-36.6286661,-72.0882617,14z/data=!3m1!4b1!4m9!4m8!1m1!4e1!1m5!1m1!1s0x966929b89fb7696f:0x58ee2eaa2b7b4b96!2m2!1d-72.077938!2d-36.6254031?entry=ttu" target="_blank">
                            <p class="text-sm font-semibold"><i class="fa-solid fa-map-pin"></i> Sydney College</p>
                        </a>
                        <p class="text-sm text-gray-400 font-semibold"><i class="fa-solid fa-map-location"></i> Av Alonso de Ercilla 2795, Chillán, Ñuble</p>
                    </div>
                    <div class="flex flex-col gap-4">
                        <h2 class="font-bold">Inscribete a nuestro NewsLetter</h2>
                        <NewsletterForm client:load/>
                    </div>
                </main>
            </div>
        </div>
    </section>
    
    <section class="flex justify-center mt-10 mb-4 border-t border-gray-600 border-opacity-50 max-w-xl md:max-w-5xl mx-auto my-0 pt-4">
        <h2>Comunidad Clan - Somos Clan, Somos Familia</h2>
    </section>
</div>

<script>
</script>